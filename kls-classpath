#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ -f "$HOME/.zshrc.extra" ]]; then
    # VS Code launched from Finder may not inherit JAVA_HOME or Android SDK variables.
    source "$HOME/.zshrc.extra"
fi

source "$project_dir/scripts/java-toolchain.sh"

exec "$project_dir/gradlew" -q :app:kotlinLanguageServerClasspath --no-daemon
