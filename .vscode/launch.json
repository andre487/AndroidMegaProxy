{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node-terminal",
      "name": "Run MegaProxy on Emulator",
      "request": "launch",
      "command": "${workspaceFolder}/scripts/run-without-debugging.sh",
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "java",
      "name": "Attach MegaProxy (JDWP)",
      "request": "attach",
      "hostName": "127.0.0.1",
      "port": 8700,
      "timeout": 60000,
      "sourcePaths": [
        "${workspaceFolder}/app/src/main/java"
      ],
      "preLaunchTask": "Android: Prepare JDWP"
    }
  ]
}
