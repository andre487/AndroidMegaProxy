default_platform(:android)

opt_out_usage
ensure_bundle_exec
ruby_version("3.4.0")

project_root = File.expand_path("..", __dir__)

platform :android do
  desc "Run the native Go tests with the race detector"
  lane :native_tests do
    Dir.chdir(File.join(project_root, "native")) do
      sh("go test -race ./...")
    end
  end

  desc "Build the native AAR used by Android builds"
  private_lane :native_library do
    sh(File.join(project_root, "scripts", "build-fdroid-native.sh"))
  end

  private_lane :ensure_no_release_signing do
    signing_variables = %w[
      MEGAPROXY_KEYSTORE_PATH
      MEGAPROXY_KEYSTORE_PASSWORD
      MEGAPROXY_KEY_ALIAS
      MEGAPROXY_KEY_PASSWORD
      MEGAPROXY_KEY_PASSWORD_FILE
    ]
    configured_signing_variables = signing_variables.select do |name|
      !ENV.fetch(name, "").empty?
    end
    unless configured_signing_variables.empty?
      UI.user_error!(
        "Signing configuration must not be available to unsigned checks or UI tests: " \
        "#{configured_signing_variables.join(', ')}"
      )
    end
  end

  desc "Run Android checks, build a debug APK, and verify that the CI release APK is unsigned"
  lane :android_checks do
    ensure_no_release_signing

    native_library
    gradle(
      tasks: %w[testDebugUnitTest lintDebug assembleDebug assembleRelease],
      flags: "--no-daemon",
      project_dir: project_root
    )

    unsigned_apk = File.join(
      project_root,
      "app/build/outputs/apk/release/app-release-unsigned.apk"
    )
    UI.user_error!("Expected unsigned release APK was not produced") unless File.file?(unsigned_apk)

    android_home = ENV.fetch("ANDROID_HOME") do
      UI.user_error!("ANDROID_HOME is required to verify the release APK")
    end
    apksigner = File.join(android_home, "build-tools", "36.0.0", "apksigner")
    UI.user_error!("Android apksigner is unavailable: #{apksigner}") unless File.executable?(apksigner)

    if system(apksigner, "verify", unsigned_apk, out: File::NULL, err: File::NULL)
      UI.user_error!("CI release APK is unexpectedly signed: #{unsigned_apk}")
    end
    UI.success("Debug APK: app/build/outputs/apk/debug/app-debug.apk")
    UI.success("Verified unsigned release APK: app/build/outputs/apk/release/app-release-unsigned.apk")
  end

  desc "Run every native and Android test and check"
  lane :test do
    native_tests
    android_checks
  end

  desc "Test the Selectel lease lifecycle and instrumentation result parser without a device"
  lane :selectel_contract_tests do
    sh("python3", "-m", "unittest", "discover", "-s", File.join(project_root, "scripts", "tests"))
  end

  desc "Format Python scripts with isort and Black"
  lane :python_format do
    python = ENV.fetch("PYTHON", "python3")
    Dir.chdir(project_root) do
      sh(python, "-m", "isort", "scripts")
      sh(python, "-m", "black", "scripts")
    end
  end

  desc "Check Python formatting, import order, and runner contracts"
  lane :python_checks do
    python = ENV.fetch("PYTHON", "python3")
    Dir.chdir(project_root) do
      sh(python, "-m", "isort", "--check-only", "scripts")
      sh(python, "-m", "black", "--check", "scripts")
    end
    selectel_contract_tests
  end

  desc "Build debug application and instrumentation APKs before renting a device"
  lane :ui_test_artifacts do |options|
    profile = options[:profile] || "required"
    UI.user_error!("profile must be required or additional") unless %w[required additional].include?(profile)
    require "json"
    devices = JSON.parse(File.read(File.join(project_root, "config", "selectel-devices.json"))).fetch("devices")
    needs_arm32 = profile == "additional" && devices.any? { |device| device.fetch("abi") == "armeabi-v7a" }
    variant = needs_arm32 ? "universal" : "arm64-v8a"
    ensure_no_release_signing
    selectel_contract_tests
    native_library
    gradle(tasks: %w[assembleDebug assembleDebugAndroidTest],
           flags: "--no-daemon -PmegaproxyVersionVariant=#{variant}", project_dir: project_root)
  end

  desc "Check Selectel access and device availability without renting"
  lane :selectel_probe do
    sh("bash", File.join(project_root, "scripts", "selectel-ui.sh"), "probe")
  end

  desc "Rent and connect one Selectel Android device for the prebuilt UI test APKs"
  lane :selectel_acquire do
    sh("bash", File.join(project_root, "scripts", "selectel-ui.sh"), "acquire")
  end

  desc "Run prebuilt UI tests on the device recorded in the Selectel lease journal"
  lane :selectel_run do
    sh("bash", File.join(project_root, "scripts", "selectel-ui.sh"), "run")
  end

  desc "Release all Selectel leases recorded by this checkout (safe to repeat)"
  lane :selectel_release do
    sh("bash", File.join(project_root, "scripts", "selectel-ui.sh"), "release-all")
  end

  desc "Rent, run prebuilt UI tests, and release a Selectel Android device"
  lane :selectel_ui_tests do |options|
    profile = options[:profile] || "required"
    UI.user_error!("profile must be required or additional") unless %w[required additional].include?(profile)
    if profile == "additional"
      sh("bash", File.join(project_root, "scripts", "selectel-ui.sh"), "matrix-test", "--profile", profile)
    else
      sh("bash", File.join(project_root, "scripts", "selectel-ui.sh"), "test")
    end
  end

  desc "Build a debug APK after preparing the native library"
  lane :debug_artifact do
    native_library
    gradle(
      task: "assembleDebug",
      flags: "--no-daemon",
      project_dir: project_root
    )
    UI.success("Debug APK: app/build/outputs/apk/debug/app-debug.apk")
  end

  desc "Build and verify all signed release APK, AAB, symbols, and checksum artifacts"
  lane :release_artifacts do
    sh(File.join(project_root, "scripts", "build-release-apks.sh"))
    sh(File.join(project_root, "scripts", "build-release-bundle.sh"))
    UI.success("Release artifacts: dist/release")
  end
end
