default_platform(:android)

opt_out_usage
ensure_bundle_exec
ruby_version("3.4.0")

project_root = File.expand_path("..", __dir__)

platform :android do
  desc "Run the native Go tests with the race detector"
  lane :native_tests do
    Dir.chdir(File.join(project_root, "native")) do
      sh("go test -race ./...")
    end
  end

  desc "Test production dialers against disposable GOST and OpenSSH servers (requires Docker)"
  lane :native_integration do
    Dir.chdir(File.join(project_root, "native")) do
      sh("go", "test", "-race", "-tags=integration", "./mobile", "-run=^TestRealProxyServers$", "-count=1", "-timeout=15m", "-v")
    end
  end

  desc "Fuzz native config, JA3 and DNS parsers for 20 seconds with two workers"
  lane :native_fuzz do
    Dir.chdir(File.join(project_root, "native")) do
      sh("go", "test", "./mobile", "-run=^$", "-fuzz=FuzzNativeParsers", "-fuzztime=20s", "-parallel=2")
    end
  end

  desc "Build the native AAR used by Android builds"
  private_lane :native_library do
    sh(File.join(project_root, "scripts", "build-fdroid-native.sh"))
  end

  desc "Run Android checks, build a debug APK, and verify that the CI release APK is unsigned"
  lane :android_checks do
    signing_variables = %w[
      MEGAPROXY_KEYSTORE_PATH
      MEGAPROXY_KEYSTORE_PASSWORD
      MEGAPROXY_KEY_ALIAS
      MEGAPROXY_KEY_PASSWORD
      MEGAPROXY_KEY_PASSWORD_FILE
    ]
    configured_signing_variables = signing_variables.select do |name|
      !ENV.fetch(name, "").empty?
    end
    unless configured_signing_variables.empty?
      UI.user_error!(
        "Signing configuration must not be available to android_checks: " \
        "#{configured_signing_variables.join(', ')}"
      )
    end

    native_library
    gradle(
      tasks: %w[testDebugUnitTest lintDebug assembleDebug assembleRelease],
      flags: "--no-daemon",
      project_dir: project_root
    )

    unsigned_apk = File.join(
      project_root,
      "app/build/outputs/apk/release/app-release-unsigned.apk"
    )
    UI.user_error!("Expected unsigned release APK was not produced") unless File.file?(unsigned_apk)

    android_home = ENV.fetch("ANDROID_HOME") do
      UI.user_error!("ANDROID_HOME is required to verify the release APK")
    end
    apksigner = File.join(android_home, "build-tools", "36.0.0", "apksigner")
    UI.user_error!("Android apksigner is unavailable: #{apksigner}") unless File.executable?(apksigner)

    if system(apksigner, "verify", unsigned_apk, out: File::NULL, err: File::NULL)
      UI.user_error!("CI release APK is unexpectedly signed: #{unsigned_apk}")
    end
    UI.success("Debug APK: app/build/outputs/apk/debug/app-debug.apk")
    UI.success("Verified unsigned release APK: app/build/outputs/apk/release/app-release-unsigned.apk")
  end

  desc "Build debug and instrumentation APKs for a disposable emulator"
  lane :device_test_build do
    native_library
    gradle(tasks: %w[assembleDebug assembleDebugAndroidTest], flags: "--no-daemon", project_dir: project_root)
  end

  desc "Run real VPN, Keystore and document-provider tests on a disposable API 26 or 35 emulator"
  lane :device_tests do |options|
    api = options[:api].to_s
    UI.user_error!("Use api:26 or api:35") unless %w[26 35].include?(api)
    sh(ENV.fetch("PYTHON", "python3"), File.join(project_root, "scripts/android_device_tests.py"), "--api", api)
  end

  desc "Run every native and Android test and check"
  lane :test do
    native_tests
    android_checks
  end

  desc "Run Python unit tests"
  lane :python_tests do
    python = ENV.fetch("PYTHON", "python3")
    sh(python, "-m", "unittest", "discover", "-s", File.join(project_root, "scripts", "tests"))
  end

  desc "Format Python scripts with isort and Black"
  lane :python_format do
    python = ENV.fetch("PYTHON", "python3")
    Dir.chdir(project_root) do
      sh(python, "-m", "isort", "scripts")
      sh(python, "-m", "black", "scripts")
    end
  end

  desc "Check Python formatting, import order, and unit tests"
  lane :python_checks do
    python = ENV.fetch("PYTHON", "python3")
    Dir.chdir(project_root) do
      sh(python, "-m", "isort", "--check-only", "scripts")
      sh(python, "-m", "black", "--check", "scripts")
    end
    python_tests
  end

  desc "Build a debug APK after preparing the native library"
  lane :debug_artifact do
    native_library
    gradle(
      task: "assembleDebug",
      flags: "--no-daemon",
      project_dir: project_root
    )
    UI.success("Debug APK: app/build/outputs/apk/debug/app-debug.apk")
  end

  desc "Generate EN/RU release notes, bump the version, and create a release PR"
  lane :release_prepare do |options|
    version = options[:version] || ENV.fetch("RELEASE_VERSION")
    Dir.chdir(project_root) do
      sh(ENV.fetch("PYTHON", "python3"), "scripts/release_automation.py", "prepare", "--version", version)
    end
  end

  desc "Wait for full release PR CI, squash merge, and tag its verified merged commit"
  lane :release_finish do |options|
    version = options[:version] || ENV.fetch("RELEASE_VERSION")
    pr = options[:pr] || ENV.fetch("RELEASE_PR")
    head = options[:head] || ENV.fetch("RELEASE_HEAD")
    Dir.chdir(project_root) do
      sh(ENV.fetch("PYTHON", "python3"), "scripts/release_automation.py", "finish",
         "--version", version.to_s, "--pr", pr.to_s, "--head", head.to_s)
    end
  end

  desc "Build and verify all signed release APK and checksum artifacts"
  lane :release_artifacts do
    sh(File.join(project_root, "scripts", "build-release-apks.sh"))
    UI.success("Release artifacts: dist/release")
  end
end
