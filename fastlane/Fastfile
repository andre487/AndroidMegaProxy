require "open3"
require "tmpdir"
require "fileutils"
require "json"

default_platform(:android)

opt_out_usage
ensure_bundle_exec
ruby_version("3.4.0")

project_root = File.expand_path("..", __dir__)

platform :android do
  desc "Run the native Go tests with the race detector"
  lane :native_tests do
    Dir.chdir(File.join(project_root, "native")) do
      sh("go test -race ./...")
    end
  end

  desc "Fuzz native config, JA3 and DNS parsers for 20 seconds with two workers"
  lane :native_fuzz do
    Dir.chdir(File.join(project_root, "native")) do
      sh("go", "test", "./mobile", "-run=^$", "-fuzz=FuzzNativeParsers", "-fuzztime=20s", "-parallel=2")
    end
  end

  desc "Build the native AAR used by Android builds"
  private_lane :native_library do
    sh(File.join(project_root, "scripts", "build-fdroid-native.sh"))
  end

  desc "Run Android checks, build a debug APK, and verify that the CI release APK is unsigned"
  lane :android_checks do
    signing_variables = %w[
      MEGAPROXY_KEYSTORE_PATH
      MEGAPROXY_KEYSTORE_PASSWORD
      MEGAPROXY_KEY_ALIAS
      MEGAPROXY_KEY_PASSWORD
      MEGAPROXY_KEY_PASSWORD_FILE
    ]
    configured_signing_variables = signing_variables.select do |name|
      !ENV.fetch(name, "").empty?
    end
    unless configured_signing_variables.empty?
      UI.user_error!(
        "Signing configuration must not be available to android_checks: " \
        "#{configured_signing_variables.join(', ')}"
      )
    end

    native_library
    gradle(
      tasks: %w[testDebugUnitTest lintDebug assembleDebug assembleRelease],
      flags: "--no-daemon",
      project_dir: project_root
    )

    unsigned_apk = File.join(
      project_root,
      "app/build/outputs/apk/release/app-release-unsigned.apk"
    )
    UI.user_error!("Expected unsigned release APK was not produced") unless File.file?(unsigned_apk)

    android_home = ENV.fetch("ANDROID_HOME") do
      UI.user_error!("ANDROID_HOME is required to verify the release APK")
    end
    apksigner = File.join(android_home, "build-tools", "36.0.0", "apksigner")
    UI.user_error!("Android apksigner is unavailable: #{apksigner}") unless File.executable?(apksigner)

    if system(apksigner, "verify", unsigned_apk, out: File::NULL, err: File::NULL)
      UI.user_error!("CI release APK is unexpectedly signed: #{unsigned_apk}")
    end
    UI.success("Debug APK: app/build/outputs/apk/debug/app-debug.apk")
    UI.success("Verified unsigned release APK: app/build/outputs/apk/release/app-release-unsigned.apk")
  end

  desc "Run every native and Android test and check"
  lane :test do
    native_tests
    android_checks
  end

  desc "Run Python unit tests"
  lane :python_tests do
    python = ENV.fetch("PYTHON", "python3")
    sh(python, "-m", "unittest", "discover", "-s", File.join(project_root, "scripts", "tests"))
  end

  desc "Format Python scripts with isort and Black"
  lane :python_format do
    python = ENV.fetch("PYTHON", "python3")
    Dir.chdir(project_root) do
      sh(python, "-m", "isort", "scripts")
      sh(python, "-m", "black", "scripts")
    end
  end

  desc "Check Python formatting, import order, and unit tests"
  lane :python_checks do
    python = ENV.fetch("PYTHON", "python3")
    Dir.chdir(project_root) do
      sh(python, "-m", "isort", "--check-only", "scripts")
      sh(python, "-m", "black", "--check", "scripts")
    end
    python_tests
  end

  desc "Build a debug APK after preparing the native library"
  lane :debug_artifact do
    native_library
    gradle(
      task: "assembleDebug",
      flags: "--no-daemon",
      project_dir: project_root
    )
    UI.success("Debug APK: app/build/outputs/apk/debug/app-debug.apk")
  end

  desc "Build and verify all signed release APK, AAB, symbols, and checksum artifacts"
  lane :release_artifacts do
    sh(File.join(project_root, "scripts", "build-release-apks.sh"))
    sh(File.join(project_root, "scripts", "build-release-bundle.sh"))
    UI.success("Release artifacts: dist/release")
  end

  private_lane :play_credentials do
    json_key_data = ENV["SUPPLY_JSON_KEY_DATA"]
    if json_key_data.to_s.strip.empty?
      UI.user_error!("Set SUPPLY_JSON_KEY_DATA to the service-account JSON contents")
    end
    begin
      credentials = JSON.parse(json_key_data)
    rescue JSON::ParserError
      UI.user_error!("SUPPLY_JSON_KEY_DATA must contain valid JSON")
    end
    unless credentials.is_a?(Hash) && credentials["type"] == "service_account" &&
           %w[client_email private_key token_uri].all? { |key| credentials[key].is_a?(String) && !credentials[key].strip.empty? }
      UI.user_error!("SUPPLY_JSON_KEY_DATA must contain a service-account key with client_email, private_key and token_uri")
    end
    json_key_data
  end

  desc "Upload store text and artwork from a release tag; leave submission to Play Console"
  lane :play_metadata do |options|
    unknown_options = options.keys - [:release_tag]
    UI.user_error!("Unknown play_metadata options: #{unknown_options.join(', ')}") unless unknown_options.empty?
    tag = options.fetch(:release_tag, ENV["PLAY_METADATA_RELEASE_TAG"]).to_s
    unless tag.match?(/\Av[0-9]+\.[0-9]+\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?\z/)
      UI.user_error!("release_tag must be a version tag such as v0.1.1")
    end
    commit, _, status = Open3.capture3("git", "-C", project_root, "rev-parse", "--verify", "refs/tags/#{tag}^{commit}")
    UI.user_error!("Release tag #{tag} is unavailable; fetch tags first") unless status.success?
    commit = commit.strip
    read_at_commit = lambda do |path|
      text, _, result = Open3.capture3("git", "-C", project_root, "show", "#{commit}:#{path}")
      UI.user_error!("Missing #{path} in #{tag}") unless result.success?
      text.force_encoding(Encoding::UTF_8)
    end
    version = read_at_commit.call("app/build.gradle.kts")[/^\s*versionName = "([^"]+)"/, 1]
    UI.user_error!("Release tag does not match its Android versionName") unless tag == "v#{version}"

    Dir.mktmpdir("megaproxy-play-metadata-") do |metadata_path|
      %w[en-US ru-RU].each do |language|
        FileUtils.mkdir_p(File.join(metadata_path, language))
        { "title" => 30, "short_description" => 80, "full_description" => 4000 }.each do |field, limit|
          text = read_at_commit.call("fastlane/metadata/android/#{language}/#{field}.txt").strip
          unless text.valid_encoding? && !text.empty? && text.length <= limit
            UI.user_error!("Invalid #{language}/#{field}: expected 1–#{limit} UTF-8 characters")
          end
          File.write(File.join(metadata_path, language, "#{field}.txt"), text)
        end
        images_root = "fastlane/metadata/android/#{language}/images"
        paths, _, result = Open3.capture3("git", "-C", project_root, "ls-tree", "-rz", "--name-only", "#{commit}:#{images_root}")
        UI.user_error!("Missing #{language} images in #{tag}") unless result.success?
        images = paths.split("\0").select do |path|
          path.match?(%r{\A(?:(?:icon|featureGraphic|promoGraphic|tvBanner)|(?:phoneScreenshots|sevenInchScreenshots|tenInchScreenshots|tvScreenshots|wearScreenshots)/[^/]+)\.(?:png|jpe?g)\z}i)
        end
        unless %w[icon featureGraphic].all? { |name| images.any? { |path| path.match?(/\A#{name}\.(png|jpe?g)\z/i) } } &&
               (2..8).cover?(images.count { |path| path.start_with?("phoneScreenshots/") })
          UI.user_error!("#{language} requires an icon, feature graphic, and 2–8 phone screenshots")
        end
        images.each do |path|
          data = read_at_commit.call("#{images_root}/#{path}").b
          unless data.start_with?("\x89PNG\r\n\x1a\n".b, "\xff\xd8\xff".b)
            UI.user_error!("#{language}/images/#{path} is not PNG/JPEG data (Git LFS pointers are not supported)")
          end
          destination = File.join(metadata_path, language, "images", path)
          FileUtils.mkdir_p(File.dirname(destination))
          File.binwrite(destination, data)
        end
      end
      UI.message("Store listing source: #{tag} (#{commit})")
      upload_to_play_store(
        json_key_data: play_credentials,
        package_name: "net.megaproxy487",
        metadata_path: metadata_path,
        skip_upload_apk: true,
        skip_upload_aab: true,
        skip_upload_metadata: false,
        skip_upload_changelogs: true,
        skip_upload_images: false,
        skip_upload_screenshots: false,
        changes_not_sent_for_review: true,
        rescue_changes_not_sent_for_review: false
      )
    end
  end

  desc "Upload a signed release AAB and native symbols to Google Play (internal draft by default)"
  lane :play_release do |options|
    allowed_options = %i[aab symbols track release_status validate_only]
    unknown_options = options.keys - allowed_options
    UI.user_error!("Unknown play_release options: #{unknown_options.join(', ')}") unless unknown_options.empty?

    track = options.fetch(:track, "internal").to_s
    UI.user_error!("track must not be empty") if track.strip.empty?
    release_status = options.fetch(:release_status, "draft").to_s
    unless %w[draft completed].include?(release_status)
      UI.user_error!("release_status must be draft or completed")
    end
    validate_only = options.fetch(:validate_only, false).to_s
    unless %w[true false].include?(validate_only)
      UI.user_error!("validate_only must be true or false")
    end

    json_key_data = play_credentials
    release_dir = File.expand_path(ENV.fetch("MEGAPROXY_RELEASE_DIR", "dist/release"), project_root)
    files = {
      aab: File.expand_path(options.fetch(:aab, File.join(release_dir, "mega-proxy.aab")), project_root),
      mapping: File.expand_path(options.fetch(:symbols, File.join(release_dir, "mega-proxy-native-debug-symbols.zip")), project_root)
    }
    files.each do |name, path|
      unless File.file?(path) && File.readable?(path) && File.size?(path)
        UI.user_error!("#{name} must be a readable, non-empty file: #{path}")
      end
    end
    UI.user_error!("aab must have the .aab extension") unless File.extname(files[:aab]) == ".aab"
    UI.user_error!("symbols must have the .zip extension") unless File.extname(files[:mapping]) == ".zip"

    app_version = File.read(File.join(project_root, "app/build.gradle.kts"))[/^\s*versionName = "([^"]+)"/, 1]
    UI.user_error!("Could not read versionName from app/build.gradle.kts") unless app_version

    upload_to_play_store(
      **files,
      json_key_data: json_key_data,
      package_name: "net.megaproxy487",
      version_name: "Version #{app_version}",
      metadata_path: File.join(project_root, "fastlane/metadata/android"),
      track: track,
      release_status: release_status,
      validate_only: validate_only == "true",
      skip_upload_apk: true,
      skip_upload_aab: false,
      skip_upload_metadata: true,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
