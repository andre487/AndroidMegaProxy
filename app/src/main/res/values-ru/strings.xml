    <string name="visibility_intro">Локальные проверки показывают признаки, доступные другому Android-приложению. Сетевые запросы, геолокация и внешние сервисы репутации не используются.</string>
    <string name="globally_observable_signals">Глобально видимые признаки</string><string name="visible_to_selected_apps">Видно выбранным приложениям</string><string name="vpn_network_signals">Признаки VPN-сети</string>
    <string name="split_visibility_explanation">Признаки ниже относятся к VPN-сети. При раздельном туннелировании Android показывает её выбранным приложениям, а исключённые используют основную сеть.</string>
    <string name="visibility_disclaimer">Обнаруженный признак сам по себе ничего не доказывает. Android намеренно раскрывает часть состояния VPN; такие же признаки создают обычные приложения безопасности и фильтрации.</string>
    <string name="excluded_apps_underlying_network">%1$s Исключённые приложения используют основную сеть.</string>
    <string name="system_proxy_properties">Системные параметры прокси</string><string name="system_proxy_yes">Видно глобальное свойство прокси процесса.</string><string name="system_proxy_no">Глобальное свойство прокси процесса не видно.</string>
    <string name="vpn_interface_name">Имя VPN-интерфейса</string><string name="vpn_interface_yes">Имя активного интерфейса похоже на tun, tap, wg, ppp или ipsec.</string><string name="vpn_interface_no">Активных интерфейсов с типичным VPN-именем нет.</string>
    <string name="unusual_vpn_mtu">Необычный MTU VPN</string><string name="unusual_vpn_mtu_yes">VPN-интерфейс использует MTU, отличный от 1280 и 1500.</string><string name="unusual_vpn_mtu_no">Необычный MTU у VPN-интерфейсов не найден.</string>
    <string name="local_mitm_certificate">Локальный MITM-сертификат</string><string name="local_mitm_certificate_detail">MegaProxy не устанавливает CA-сертификаты и не перехватывает TLS.</string>
    <string name="vpn_transport">Транспорт VPN</string><string name="vpn_transport_yes">Android показывает сеть с TRANSPORT_VPN.</string><string name="vpn_transport_no">Транспорт VPN сейчас не виден.</string>
    <string name="vpn_transport_information">Информация о транспорте VPN</string><string name="vpn_info_yes">Android показывает VpnTransportInfo для VPN-сети.</string><string name="vpn_info_no">VpnTransportInfo не виден в доступных сетях.</string>
    <string name="not_vpn_capability">Возможность NOT_VPN</string><string name="not_vpn_yes">У VPN-сети нет NET_CAPABILITY_NOT_VPN.</string><string name="not_vpn_no">По этой проверке ни одна видимая сеть не определена как VPN.</string>
    <string name="vpn_link_proxy">Прокси VPN-сети</string><string name="vpn_link_proxy_yes">К VPN-сети привязана настройка прокси.</string><string name="vpn_link_proxy_no">К VPN-сети не привязана настройка прокси.</string>
    <string name="virtual_default_route">Виртуальный маршрут по умолчанию</string><string name="virtual_route_yes">Видимый маршрут по умолчанию использует VPN-интерфейс.</string><string name="virtual_route_no">Маршрут по умолчанию через VPN-интерфейс не виден.</string>
    <string name="virtual_dns_address">Виртуальный адрес DNS</string><string name="virtual_dns_yes">VPN-сеть показывает частный, link-local или loopback-адрес DNS.</string><string name="virtual_dns_no">VPN-сеть не показывает локальный адрес DNS.</string>
