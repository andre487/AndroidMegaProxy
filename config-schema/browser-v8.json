{
  "schema": "net.megaproxy487.config",
  "version": 8,
  "passwordsIncluded": false,
  "privateKeysIncluded": false,
  "activeProfileId": null,
  "routing": {
    "bypassLocalNetworks": true
  },
  "profiles": [
    {
      "id": "example-proxy",
      "name": "Example",
      "color": 5,
      "countryCode": "",
      "proxy": {
        "type": "HTTPS",
        "host": "proxy.example.com",
        "port": 443,
        "username": "demo"
      },
      "browser": {
        "knockHost": "knock.example.com",
        "bypass": [
          "intranet.example.com"
        ],
        "authMode": "auto"
      }
    }
  ],
  "browser": {
    "theme": "system",
    "language": "auto",
    "routing": {
      "enabled": true,
      "mode": "domains",
      "domains": [
        "example.com",
        "*.example.org"
      ],
      "sites": [
        "site.example.com"
      ],
      "subscriptions": {
        "domainSources": [
          "youtube"
        ],
        "siteSources": [
          "discord"
        ],
        "autoUpdate": true,
        "throughProxy": false
      }
    }
  }
}
